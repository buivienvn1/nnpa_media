<Window x:Class="NNPA.Huongdan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NNPA"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Title="Hướng Dẫn" SizeToContent="WidthAndHeight">
    <StackPanel Margin="10">
        <Border Background="GhostWhite" BorderBrush="Silver" BorderThickness="1" CornerRadius="5">
            <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Nhạc nước Phát An (NNPA) dành cho Windows"
                           FontWeight="Bold" FontSize="16" Margin="10"/>
                <TextBlock x:Name="txtCurrentVersion" HorizontalAlignment="Center"
                           FontWeight="Normal" FontSize="14" Margin="10"/>

            </StackPanel>
        </Border>
        <TextBlock Text="Hướng Dẫn Cài Đặt" HorizontalAlignment="Center"
                           FontWeight="Bold"  FontSize="14" Margin="20"/>
        <TextBlock FontWeight="Normal" FontSize="15" Margin="30 10 10 10" HorizontalAlignment="Left" >
            1. Vào mục Cài Đặt, thay đổi địa chỉ IP của bộ trung tâm.
        </TextBlock>

        <TextBlock FontWeight="Normal" FontSize="15" Margin="30 10 10 10" HorizontalAlignment="Left" >
            2. Trong mục Cài Đặt, tìm và chọn nơi lưu File Chạy và File MP3.
        </TextBlock>

        <!--<TextBlock FontWeight="Normal" FontSize="15" Margin="0,20,0,5" HorizontalAlignment="Center" >

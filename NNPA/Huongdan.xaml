        </TextBlock>
        <TextBlock FontWeight="Normal" FontSize="15" Margin="5" HorizontalAlignment="Center" >
            Hỗ trợ: giang.phatan@gmail.com
        </TextBlock>

        <TextBlock FontWeight="Normal" FontSize="15" Margin="25" HorizontalAlignment="Center" >
            Website: nhacnuocphatan.com
        </TextBlock>-->

        

<Window x:Class="NNPA.Thongtin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NNPA"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Title="Thông tin" SizeToContent="WidthAndHeight">
    <StackPanel Margin="10">
        <Border Background="GhostWhite" BorderBrush="Silver" BorderThickness="1" CornerRadius="5">
            <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Nhạc nước Phát An (NNPA) dành cho Windows"
                           FontWeight="Bold" FontSize="16" Margin="10"/>
                <TextBlock Text="Version 22.01.00" HorizontalAlignment="Center"
                           FontWeight="Normal" FontSize="14" Margin="10"/>

            </StackPanel>
        </Border>
        <TextBlock Text="Bản quyền (C) 2022 Công ty cổ phần XDTM &amp; DV Phát An" HorizontalAlignment="Center"
                           FontWeight="Normal" FontSize="14" Margin="20"/>
        <TextBlock FontWeight="Normal" FontSize="15" Margin="10" HorizontalAlignment="Center" >
            Trụ sở chính: Phú Cát – Quốc Oai – Hà Nội
        </TextBlock>

        <TextBlock FontWeight="Normal" FontSize="15" Margin="0" HorizontalAlignment="Center" >
            ĐT: 024.66.527.028 - DĐ: 039.713.5555
        </TextBlock>

        <TextBlock FontWeight="Normal" FontSize="15" Margin="0,20,0,5" HorizontalAlignment="Center" >
            Liên hệ: nhacnuocphatan@gmail.com
        </TextBlock>
        <TextBlock FontWeight="Normal" FontSize="15" Margin="5" HorizontalAlignment="Center" >
            Hỗ trợ: giang.phatan@gmail.com
        </TextBlock>

        <TextBlock FontWeight="Normal" FontSize="15" Margin="25" HorizontalAlignment="Center" >
            Website: nhacnuocphatan.com
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="12" HorizontalAlignment="Center">
            <Button Name="btnTruycap" Click="BtnTruycap_Click"  Content="Truy cập trang web" Margin="0,0,40,0" Width="170"/>
            <Button Name="btnDong" Click="BtnDong_Click"  Content="Đóng" Margin="40,0,0,0" Width="170"/>
        </StackPanel>
    </StackPanel>
</Window>

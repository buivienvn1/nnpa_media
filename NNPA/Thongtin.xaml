<Window x:Class="NNPA.Thongtin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="Thông tin và cập nhật"
        Width="570" Height="650">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="GhostWhite" BorderBrush="Silver"
                BorderThickness="1" CornerRadius="5" Padding="14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Nhạc nước Phát An (NNPA) dành cho Windows"
                           FontWeight="Bold" FontSize="16"/>
                <TextBlock x:Name="txtCurrentVersion" HorizontalAlignment="Center"
                           FontSize="14" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,8">
            <TextBlock Text="Bản quyền (C) Công ty cổ phần XDTM và DV Phát An"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Phú Cát – Quốc Oai – Hà Nội | 024.66.527.028 - 039.713.5555"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="nhacnuocphatan@gmail.com | nhacnuocphatan.com"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Cập nhật phần mềm" Padding="10" Margin="0,5,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtUpdateStatus" Grid.Row="0" Text="Sẵn sàng kiểm tra cập nhật."
                           TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="txtReleaseInfo" Grid.Row="1" TextWrapping="Wrap"
                           Foreground="DimGray" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Text="Nội dung phiên bản:" FontWeight="SemiBold"/>
                <ListBox x:Name="lstChangelog" Grid.Row="3" MinHeight="120" Margin="0,5,0,8"
                         IsHitTestVisible="False"/>
                <ProgressBar x:Name="prgDownload" Grid.Row="4" Height="18" Minimum="0" Maximum="100"
                             Visibility="Collapsed"/>
                <Grid Grid.Row="5" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="chkAutoCheck" Content="Tự động kiểm tra cập nhật khi mở phần mềm"
                              VerticalAlignment="Center" Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed"/>
                    <TextBlock x:Name="txtDownloadProgress" Grid.Column="1" VerticalAlignment="Center"
                               Foreground="DimGray"/>
                </Grid>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnTruycap" Grid.Column="0" Click="BtnTruycap_Click"
                    Content="Trang web" Width="90" Height="30"/>
            <Button x:Name="btnCheck" Grid.Column="2" Click="BtnCheck_Click"
                    Content="Kiểm tra cập nhật" Width="125" Height="30" Margin="6,0"/>
            <Button x:Name="btnUpdate" Grid.Column="3" Click="BtnUpdate_Click"
                    Content="Tải và cập nhật" Width="120" Height="30" Margin="0,0,6,0"
                    IsEnabled="False"/>
            <Button x:Name="btnDong" Grid.Column="4" Click="BtnDong_Click"
                    Content="Đóng" Width="75" Height="30"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="NNPA.LoginLoad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NNPA"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:model="clr-namespace:NNPA.Model"
        
        mc:Ignorable="d"
        Title="Nhạc Nước Phát An" Height="700" Width="1300"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" 
        Closing="Window_Closing" Loaded="Window_Loaded" >
    <Window.Resources>
        <model:MathConverter x:Key="MathConverter"/>
        
        <Style x:Key="topButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Template" >
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="50">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#dcdcdc" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="menuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D0C0FF" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="45" />
            <Setter Property="Margin" Value="15 5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template" >
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7B5CD6" />
                    <Setter Property="Foreground" Value="#ffffff" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="menuButtonIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Margin" Value="20 2 20 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>

        <Style x:Key="titleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCD7FF" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="playerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Width" Value="50" />
            <Setter Property="Margin" Value="3 0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" >
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="50">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7B5CD6" />
                    <Setter Property="Foreground" Value="#f0f0f0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="playerButtonIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>

        <Style TargetType="Image" x:Key="BusyIndicatorStyle">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Source" Value="/Images/icon_1.png"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetProperty="RenderTransform.Angle">

                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="30"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="60"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="90"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="120"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="150"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="180"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.7" Value="210"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="240"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="270"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.0" Value="300"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.1" Value="330"/>
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="360"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!--cột0 - Left menu-->
        <Border CornerRadius="10 0 0 10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#223266" Offset="0"/>
                    <GradientStop Color="#27396b" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel >
                <!--Username-->
                <StackPanel HorizontalAlignment="Center" Margin="0 35 0 0">
                  <Image Source="Images/logophatan.png" Width="100"
                       Margin="0,0,0,10"/>
                    <TextBlock Text="Nhạc nước Phát An"
                           FontWeight="SemiBold"
                           FontFamily="helvetica"
                           FontSize="21"
                           Foreground="#ccd4f0"
                           HorizontalAlignment="Center"/>
                </StackPanel>

                <Separator Height="0.8" Margin="20 30" Background="#46558a"/>

                <!--Menu button-->
                <Button Style="{StaticResource menuButton}" Background="#7B5CD6" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Home" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Trang Chủ"/>
                    </StackPanel>
                </Button>

                <Button Name="btnDoimatkhau" Click="BtnDoimatkhau_Click" Style="{StaticResource menuButton}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="KeyChange" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Đổi Mật Khẩu"/>
                    </StackPanel>
                </Button>

                <Button Name="btnCaidat" Click="BtnCaidat_Click"  Style="{StaticResource menuButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Settings" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Cài Đặt"/>
                    </StackPanel>
                </Button>

                <Button Name="btnQuanlytaikhoan" Click="BtnQuanlytaikhoan_Click" Style="{StaticResource menuButton}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tools" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Quản Lý Tài Khoản"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource menuButton}" Name="btnHuongdan" Click="BtnHuongdan_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Hướng Dẫn"/>
                    </StackPanel>
                </Button>

                <Button Name="btnThongtin" Style="{StaticResource menuButton}" Click="BtnThongtin_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Thông Tin"/>
                    </StackPanel>
                </Button>

                <Button Name="btnThoat" Click="BtnThoat_Click"
                        Style="{StaticResource menuButton}" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Margin="15 0 15 20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" Style="{StaticResource menuButtonIcon}"/>
                        <TextBlock Text="Thoát"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>


        <!--cột 1 Main section-->
        <Border Grid.Column="1" CornerRadius="0 10 10 0" MouseDown="Border_MouseDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#41518f" Offset="0"/>
                    <GradientStop Color="#2c386c" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top"
                            HorizontalAlignment="Right">
                    <!--Top Buttons-->
                    <Button Name="btnMinimize"  Click="Window_StateChanged"
                                ToolTip="Minimize"
                                Style="{StaticResource topButton}" HorizontalAlignment="Right" Margin="0" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Foreground="White"/>
                    </Button>
                    <!--Top Buttons-->
                    <Button Name="btnClose"  Click="Close_Click"
                                ToolTip="Close"
                                Style="{StaticResource topButton}" HorizontalAlignment="Right" Margin="0" >
                        <materialDesign:PackIcon Kind="CloseCircle" Foreground="White"/>
                    </Button>
                </StackPanel>
                
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="90"/>
                    </Grid.RowDefinitions>

                    <!--Title-->
                    <StackPanel Margin="40 0 35 0">
                        <Grid>
                            <TextBlock Name="txtXinchao" FontSize="28" Foreground="#CCD7FF"  Text="Chào buổi sáng, Thang" HorizontalAlignment="Left"/>
                            <!--Top Buttons-->
                            <Button Name="btnReload"  Click="BtnReload_Click"
                                ToolTip="Tự động reload mỗi 3s"
                                Style="{StaticResource topButton}" HorizontalAlignment="Right" Margin="0 0 50 0" >
                                <materialDesign:PackIcon Kind="Reload" Foreground="White"/>
                            </Button>

                            <Button Style="{StaticResource topButton}" Margin="0 0 10 0" 
                                 HorizontalAlignment="Right">
                                <materialDesign:PackIcon Kind="Bell" Foreground="White"/>
                            </Button>
                        </Grid>
                        <Separator Height="0.8" Margin="0 20"/>


                    </StackPanel>

                    <!--bảng điều khiển - danh sách bài hát-->
                    <Grid Grid.Row="1" Margin="40 0 30 30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                <TextBlock Text="Danh Sách Bài Hát" Style="{StaticResource titleText}"/>
                                <Button Name="btnPlayList" Click="BtnPlayList_Click" ToolTip="Lựa chọn bài hát trong danh sách" HorizontalAlignment="Right" Style="{StaticResource topButton}">
                                    <materialDesign:PackIcon Kind="PlaylistMusic" Height="25" Width="25" Style="{StaticResource playerButtonIcon}"/>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" CornerRadius="20" Margin="0 20 0 0">
                                <Border.Background>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#3968b6" Offset="1"/>
                                        <GradientStop Color="#122b6f" Offset="0"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                              Opacity="0.4" Color="#3671c5"/>
                                </Border.Effect>

                                <Grid >
                                    <Border Opacity="0.07" CornerRadius="20">
                                        <Border.Background>
                                            <ImageBrush ImageSource="/Images/logophatan.png"/>
                                        </Border.Background>
                                    </Border>

                                    <!-- Control list -->
                                    <Grid Margin="14 20 20 20">
                                        <ListBox Margin="0" Padding="0" SelectionChanged="LbMusic_SelectionChanged"
                                                Name="lbMusic" ItemsSource="{Binding fileList}"
                                                HorizontalContentAlignment="Stretch"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Foreground="White" FontSize="20"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                                    <Setter Property="Padding" Value="2 8"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap"
                                                            HorizontalAlignment="Left"
                                                            ToolTipService.InitialShowDelay="100" ToolTip="{Binding GhiChu}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <!-- Note Border -->
                                    <Border x:Name="tbNoteListMusic" Visibility="Collapsed" Opacity="0.5" CornerRadius="2"
                                                Background="#324557" VerticalAlignment="Bottom" Width="200" Margin="0 0 0 0">
                                        <TextBlock Text="Dừng phát nhạc để chọn bài hát" Margin="5"
                                                HorizontalAlignment="Center" Foreground="Aquamarine"/>
                                    </Border>
                                </Grid>

                            </Border>
                    </Grid>

                    <!--player-->
                    <Border Grid.Row="2" Background="#41518f" CornerRadius="20 0 10 0" Margin="40 0 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="205"/>
                                <ColumnDefinition Width="225"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="30 0 0 0">
                                <Ellipse Width="60" Height="60"  RenderTransformOrigin="0.5 0.5">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Images/icon_1.png"/>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="Rotation" Angle="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                            Storyboard.TargetName="Rotation"
                                            Storyboard.TargetProperty="Angle"
                                            From="0"
                                            To="360" Duration="0:0:5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="60" Height="60" Name="imgLogoxoay">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Images/icon_1.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>


                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20 0">
                                <TextBlock Name="txtTenBai" Text="2 Việt Nam Ơi" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="nhacnuocphatan.com" Foreground="#9ac5e3" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Name="btnPrev" Click="BtnPrev_Click" Style="{StaticResource playerButton}" ToolTip="Bài trước">
                                    <materialDesign:PackIcon Kind="SkipPrevious" Style="{StaticResource playerButtonIcon}"/>
                                </Button>
                                <Button Name="btnStart" Click="BtnStart_Click" Style="{StaticResource playerButton}" ToolTip="Phát/Tạm dừng">
                                    <materialDesign:PackIcon Kind="Play" Style="{StaticResource playerButtonIcon}"/>
                                </Button>
                                <Button Name="btnStop" Click="BtnStop_Click" Style="{StaticResource playerButton}" ToolTip="Dừng">
                                    <materialDesign:PackIcon Kind="Stop" Style="{StaticResource playerButtonIcon}"/>
                                </Button>
                                <Button Name="btnNext" Click="BtnNext_Click" Style="{StaticResource playerButton}" ToolTip="Bài sau">
                                    <materialDesign:PackIcon Kind="SkipNext" Style="{StaticResource playerButtonIcon}"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="3" Name="tbProgressStatus" Text="00:00"
                                       VerticalAlignment="Center" Foreground="#9ac5e3" Margin="0 0 10 0"/>

                            <Slider Grid.Column="4" x:Name="sliProgress" ValueChanged="sliProgress_ValueChanged"
                                    IsSelectionRangeEnabled="False" VerticalAlignment="Center" Value="0"
                                    HorizontalAlignment="Stretch" IsEnabled="False"/>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="10 0 5 0">
                                <TextBlock Name="tbTotalSecond" Text="00:00" VerticalAlignment="Center" Foreground="#9ac5e3" Margin="0 0 5 0"/>
                                <Button Name="btnRepeat" Click="BtnRepeat_Click" Style="{StaticResource playerButton}" ToolTip="Lặp lại">
                                    <materialDesign:PackIcon Kind="Repeat" Style="{StaticResource playerButtonIcon}"/>
                                </Button>
                                <Button Name="btnVolume" Click="BtnVolume_Click" Style="{StaticResource playerButton}" ToolTip="Tắt âm thanh ứng dụng">
                                    <Grid>
                                        <materialDesign:PackIcon Name="mIconVlH" Kind="VolumeHigh" Style="{StaticResource playerButtonIcon}"/>
                                        <materialDesign:PackIcon Name="mIconVlO" Visibility="Hidden" Kind="VolumeOff" Style="{StaticResource playerButtonIcon}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>

            
        </Border>

    </Grid>
</Window>
